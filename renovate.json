{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "mode": "full",
  "baseBranchPatterns": [
    "trunk"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am every weekday"
  ],
  "prConcurrentLimit": 7,
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "dependencies"
    ],
    "automerge": true
  },
  "commitMessagePrefix": "^ E(deps)",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+ARG [A-Z_]+_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile"
    }
  ]
}